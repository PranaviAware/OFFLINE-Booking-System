# ==============================================================================
# Office Link - Spring Boot Backend Environment Configuration
# Copy this file to .env or supply these environment variables to the JVM
# ==============================================================================

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=office_link
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# Server Port
PORT=5000

# Keycloak OIDC Configuration (OAuth2 Resource Server)
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/officelink
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/officelink/protocol/openid-connect/certs
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=officelink
KEYCLOAK_CLIENT_ID=officelink-frontend

# Frontend Client Origin (CORS)
CLIENT_ORIGIN=http://localhost:5173
