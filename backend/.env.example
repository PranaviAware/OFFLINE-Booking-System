# Server Configuration
PORT=5000
NODE_ENV=development

# Security & JWT Configuration
# In production, use your Auth0 or Keycloak RS256 JWKS URI and Audience
JWT_SECRET=officelink-super-secret-jwt-key-2026-production-grade
JWT_ISSUER=officelink-auth
JWT_AUDIENCE=officelink-api

# Database Path (SQLite)
DATABASE_PATH=./officelink.db

# Client Origin (CORS)
CLIENT_ORIGIN=http://localhost:5173
